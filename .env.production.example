SECRET_KEY=replace-with-a-long-random-production-secret
FIELD_ENCRYPTION_KEY=generate-with-python-c-from-cryptography-fernet-import-fernet
DEBUG=False
ALLOWED_HOSTS=medimart.example.com,www.medimart.example.com
CSRF_TRUSTED_ORIGINS=https://medimart.example.com,https://www.medimart.example.com

DB_NAME=medimart_prod
DB_USER=medimart_user
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=127.0.0.1
DB_PORT=3306

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=MediMart <medimart.notifications@gmail.com>
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=medimart.notifications@gmail.com
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=True

RAZORPAY_KEY_ID=replace-with-live-or-test-key-id
RAZORPAY_KEY_SECRET=replace-with-live-or-test-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret
RAZORPAY_CURRENCY=INR
PAYMENT_RESERVATION_MINUTES=20


SMS_BACKEND=http
SMS_API_URL=https://sms-provider.example.com/messages
SMS_API_KEY=replace-with-sms-provider-key
SMS_SENDER_ID=MEDIMART

# Use a paid or self-hosted geocoder in production. Do not rely on the public
# OpenStreetMap Nominatim endpoint for a high-traffic commercial deployment.
GEOCODING_REVERSE_URL=https://geocoder.example.com/reverse
GEOCODING_USER_AGENT=MediMart/1.0 (contact: medimart.notifications@gmail.com)
GEOCODING_TIMEOUT_SECONDS=5

# Obtain authorized API access before enabling automatic licence verification.
LICENSE_VERIFICATION_API_URL=
LICENSE_VERIFICATION_API_KEY=
LICENSE_VERIFICATION_TIMEOUT_SECONDS=8
LICENSE_VERIFICATION_USER_AGENT=MediMart/1.0 (contact: medimart.notifications@gmail.com)

USE_CLOUD_MEDIA=True
MEDIA_CLOUD_PROVIDER=s3
MEDIA_CLOUD_BUCKET=replace-with-private-bucket
AWS_ACCESS_KEY_ID=replace-with-storage-access-key
AWS_SECRET_ACCESS_KEY=replace-with-storage-secret-key
AWS_S3_REGION_NAME=ap-south-1
# Leave blank for AWS S3; set for an S3-compatible provider.
AWS_S3_ENDPOINT_URL=

SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
USE_X_FORWARDED_PROTO=True
