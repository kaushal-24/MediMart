CHATBOT_API_KEY=replace-with-ai-provider-key
CHATBOT_PROVIDER=auto
CHATBOT_MODEL=replace-with-model-name
# Comma-separated fallback models, tried from left to right after the primary model.
CHATBOT_MODELS=replace-with-primary-model,replace-with-fallback-model-1,replace-with-fallback-model-2
CHATBOT_MODEL_COOLDOWN_SECONDS=60
CHATBOT_THINKING_LEVEL=low
CHATBOT_TIMEOUT_SECONDS=30
CHATBOT_MAX_INPUT_CHARS=1000
CHATBOT_MAX_OUTPUT_CHARS=2000
CHATBOT_MAX_OUTPUT_TOKENS=500

DATA_UPLOAD_MAX_MEMORY_SIZE=12582912
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880

