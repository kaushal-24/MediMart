server {
    listen 80;
    server_name medimart.example.com www.medimart.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name medimart.example.com www.medimart.example.com;

    ssl_certificate /etc/letsencrypt/live/medimart.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/medimart.example.com/privkey.pem;

    client_max_body_size 10M;

    location /static/ {
        alias /var/www/MediMart/staticfiles/;
    }

    location /media/ {
        alias /var/www/MediMart/media/;
    }

    location / {
        proxy_pass http://unix:/run/medimart.sock;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
